    default_extension: "mp4",
    output_suffix: "direct",
    empty: "",
};

pub fn progress_summary(bytes_copied: u64, total_bytes: u64, bytes_per_second: f64) -> String {
    let percent = if total_bytes == 0 {
        100.0
    } else {
        bytes_copied as f64 / total_bytes as f64 * 100.0
    };
    format!(
        "{percent:.1}%  |  {} / {}  |  {}/s",
        format_bytes(bytes_copied),
        format_bytes(total_bytes),
        format_bytes(bytes_per_second.max(0.0) as u64)
    )
}

pub fn completed_summary(bytes: u64, elapsed: Duration) -> String {
    let speed = if elapsed.is_zero() {
        0
    } else {
        (bytes as f64 / elapsed.as_secs_f64()) as u64
    };
    format!(
        "{} copied in {} at {}/s",
        format_bytes(bytes),
        format_duration(elapsed),
        format_bytes(speed)
    )
}

pub fn error_message(error: &DirectCopyError) -> String {
    match error {
        DirectCopyError::SourceNotFound(_) => TEXT.source_missing.to_owned(),
        DirectCopyError::SourceIsNotFile(_) => TEXT.source_not_file.to_owned(),
        DirectCopyError::SamePath => TEXT.same_path.to_owned(),
        DirectCopyError::Cancelled => TEXT.cancelled_detail.to_owned(),
        DirectCopyError::Io(error) => format!("{}: {error}", TEXT.copy_failed),
    }
}

pub fn format_bytes(bytes: u64) -> String {
    const UNITS: [&str; 5] = ["B", "KiB", "MiB", "GiB", "TiB"];
    let mut value = bytes as f64;
    let mut unit = 0;
    while value >= 1024.0 && unit < UNITS.len() - 1 {
        value /= 1024.0;
        unit += 1;
    }

    if unit == 0 {
        format!("{bytes} {}", UNITS[unit])
    } else {
        format!("{value:.2} {}", UNITS[unit])
    }
}

fn format_duration(duration: Duration) -> String {
    let seconds = duration.as_secs_f64();
    if seconds < 60.0 {
        format!("{seconds:.1}s")
    } else {
        let minutes = (seconds / 60.0).floor() as u64;
        let remaining_seconds = seconds - minutes as f64 * 60.0;
        format!("{minutes}m {remaining_seconds:.0}s")
    }
}
