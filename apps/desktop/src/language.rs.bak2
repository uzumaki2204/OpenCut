    pub choose_source: &'static str,
    pub destination_label: &'static str,
    pub destination_empty: &'static str,
    pub destination_picker_title: &'static str,
    pub choose_destination: &'static str,
    pub video_filter: &'static str,
    pub ready: &'static str,
    pub ready_detail: &'static str,
    pub copying: &'static str,
    pub cancelling: &'static str,
    pub cancelled: &'static str,
    pub cancelled_detail: &'static str,
    pub completed: &'static str,
    pub start_export: &'static str,
    pub cancel: &'static str,
    pub reveal_file: &'static str,
    pub exact_copy: &'static str,
    pub exact_copy_detail: &'static str,
    pub source_missing: &'static str,
    pub source_not_file: &'static str,
    pub same_path: &'static str,
    pub copy_failed: &'static str,
    pub diagnostic_copy_failed: &'static str,
    pub window_open_failed: &'static str,
    pub default_filename: &'static str,
    pub default_extension: &'static str,
    pub output_suffix: &'static str,
    pub empty: &'static str,
}

pub const TEXT: DesktopText = DesktopText {
    app_name: "OpenCut",
    native_badge: "WINDOWS NATIVE",
    eyebrow: "DIRECT EXPORT",
    title: "Copy the original video at disk speed",
    description: "Choose a source and destination. OpenCut copies every byte directly without encoding, remuxing, uploading, or loading the video into memory.",
    source_label: "SOURCE VIDEO",
    source_empty: "No source video selected",
    source_picker_title: "Choose source video",
    choose_source: "Choose video",
    destination_label: "DESTINATION",
    destination_empty: "No destination selected",
    destination_picker_title: "Save direct copy",
    choose_destination: "Choose destination",
    video_filter: "Video",
    ready: "Ready for native copy",
    ready_detail: "Select both paths, then start Direct Export.",
    copying: "Copying original bytes",
    cancelling: "Stopping copy",
    cancelled: "Export cancelled",
    cancelled_detail: "The incomplete destination file was removed.",
    completed: "Direct Export completed",
    start_export: "Start Direct Export",
    cancel: "Cancel",
